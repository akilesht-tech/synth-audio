  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@mediagrid/capacitor-native-audio": "^2.0.0"
  }
